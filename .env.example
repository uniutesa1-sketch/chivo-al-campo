# ==============================================================================
# VARIABLES DE ENTORNO — RESTAURANTE CHIVO AL CAMPO
# Copia este archivo como .env para desarrollo local o configúralo en Cloud Run
# ==============================================================================

# Puerto de escucha del servidor (Cloud Run lo asigna automáticamente a 8080)
PORT=8080
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Recomendaciones de Upselling e IA Predictiva en Cocina)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui

# ------------------------------------------------------------------------------
# 2. Facturación Electrónica e-CF DGII (Plataforma Oficial IMECF - Ley 32-23)
# ------------------------------------------------------------------------------
ECF_API_URL=https://ecf-platform-backend-50801509587.us-central1.run.app
ECF_API_KEY=tu_token_imecf_aqui
ECF_RNC_EMISOR=132907401

# ------------------------------------------------------------------------------
# 3. Pasarela de Pago PayPal REST API (developer.paypal.com)
# ------------------------------------------------------------------------------
PAYPAL_APP_NAME="Chivo al Campo POS"
PAYPAL_CLIENT_ID=tu_paypal_client_id_aqui
PAYPAL_CLIENT_SECRET=tu_paypal_client_secret_aqui
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------------------
# 4. Datos del Restaurante y Normativa Fiscal Dominicana
# ------------------------------------------------------------------------------
RESTAURANTE_RNC=132-90740-1
RESTAURANTE_NOMBRE="Restaurante Chivo al Campo SRL"
ITBIS_PORCENTAJE=0.18
PROPINA_LEGAL_PORCENTAJE=0.10
